// ========================================
// SCHEMA PRISMA - SOGAS-RH V2.0
// ========================================
// Projet      : Système RH/Paie Complet
// Base        : MySQL 8.0+
// ORM         : Prisma 5+
// Version     : M4.0 (Auth + Employee + RBAC + Leave + Organization)
// Date        : 2025-10-11
// ========================================

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ========================================
// MODULE 1 : AUTHENTIFICATION & RBAC
// ========================================

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("passwordHash")
  firstName    String?
  lastName     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles                 UserRole[]
  sessions              Session[]
  revokedTokens         RevokedToken[]
  employee              Employee?
  reviewedLeaveRequests LeaveRequest[] @relation("LeaveReviewer")

  @@index([email])
  @@index([username])
  @@index([isActive])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@index([name])
}

model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String?  @db.VarChar(1000)  // ← CHANGÉ : Text → VarChar(1000)
  refreshToken String   @db.VarChar(1000)  // ← CHANGÉ : Text → VarChar(1000)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("session")
}

model RevokedToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  reason    String?
  revokedAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ========================================
// MODULE 2 : GESTION DES EMPLOYÉS
// ========================================

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  RESIGNED
  TERMINATED
  ONBOARDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

model Employee {
  id String @id @default(cuid())

  // Lien optionnel vers User
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // IDENTITÉ
  employeeCode String  @unique
  firstName    String
  middleName   String?
  lastName     String
  maidenName   String?
  gender       Gender?

  // CONTACTS
  email          String? @unique
  phone          String?
  phoneSecondary String?
  phoneWhatsApp  String?

  // DONNÉES CIVILES
  nin              String    @unique @db.VarChar(13)
  cniNumber        String?
  cniExpiry        DateTime?
  nineaNumber      String?
  ipmNumber        String?
  nationality      String?
  maritalStatus    String?
  numberOfChildren Int?      @default(0)
  dependentsCount  Int?      @default(0)

  // ADRESSE
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  country      String?
  postalCode   String?

  // CONTACTS D'URGENCE
  emergencyContactName  String?
  emergencyContactPhone String?

  // DONNÉES BANCAIRES
  rib String?

  // DATES
  dateOfBirth DateTime?
  hireDate    DateTime

  // PROFIL
  profilePicture String?

  // AFFECTATION ORGANISATIONNELLE (Module 4)
  siteId       String?
  departmentId String?
  serviceId    String?
  teamId       String?
  positionId   String?

  // STATUT
  status   EmployeeStatus @default(ACTIVE)
  isActive Boolean        @default(true)

  // TIMESTAMPS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS MODULE 2.4 - CONGÉS
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  // RELATIONS MODULE 4 - ORGANISATION
  site       Site?       @relation(fields: [siteId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  service    Service?    @relation(fields: [serviceId], references: [id])
  team       Team?       @relation(fields: [teamId], references: [id])
  position   Position?   @relation(fields: [positionId], references: [id])

  // INDEX
  @@index([lastName, firstName])
  @@index([status])
  @@index([email])
  @@index([employeeCode])
  @@index([siteId])
  @@index([departmentId])
  @@index([serviceId])
  @@index([teamId])
  @@index([positionId])
  @@index([cniNumber])
}

// ========================================
// MODULE 2.4 : GESTION DES CONGÉS
// ========================================

model LeaveType {
  id                String   @id @default(cuid())
  name              String   // "Congé annuel", "Maladie", etc.
  code              String   @unique // "ANNUAL", "SICK", etc.
  description       String?  @db.Text
  isPaid            Boolean  @default(true)
  requiresApproval  Boolean  @default(true)
  maxDaysPerRequest Int?     // Limite de jours par demande
  color             String?  // Pour affichage calendrier (ex: "#3B82F6")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  requests LeaveRequest[]
  balances LeaveBalance[]

  @@index([code])
  @@index([isActive])
  @@map("leave_types")
}

model LeaveBalance {
  id            String   @id @default(cuid())
  employeeId    String
  leaveTypeId   String
  year          Int      // Année fiscale
  totalDays     Decimal  @db.Decimal(5, 1) // Nombre total de jours
  usedDays      Decimal  @db.Decimal(5, 1) @default(0) // Jours utilisés
  remainingDays Decimal  @db.Decimal(5, 1) // Jours restants
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([year])
  @@map("leave_balances")
}

model LeaveRequest {
  id          String    @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime
  endDate     DateTime
  totalDays   Decimal   @db.Decimal(4, 1)
  reason      String?   @db.Text
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?   // userId du manager
  reviewNotes String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  reviewer  User?     @relation("LeaveReviewer", fields: [reviewedBy], references: [id])

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([reviewedBy])
  @@map("leave_requests")
}

// ========================================
// MODULE 4 : ORGANISATION
// ========================================

// Site / Établissement
model Site {
  id          String   @id @default(cuid())
  code        String   @unique // Code court (ex: "DKR-001")
  name        String   // Nom du site
  description String?  @db.Text
  address     String?
  city        String?
  region      String?
  country     String?  @default("Sénégal")
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees   Employee[]
  departments Department[]

  @@index([code])
  @@index([isActive])
  @@map("sites")
}

// Département
model Department {
  id          String   @id @default(cuid())
  siteId      String?  // Optionnel : un département peut être global
  code        String   @unique
  name        String
  description String?  @db.Text
  managerId   String?  // Responsable du département (Employee)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site      Site?      @relation(fields: [siteId], references: [id])
  employees Employee[]
  services  Service[]

  @@index([siteId])
  @@index([code])
  @@index([isActive])
  @@map("departments")
}

// Service (au sein d'un département)
model Service {
  id           String   @id @default(cuid())
  departmentId String
  code         String   @unique
  name         String
  description  String?  @db.Text
  managerId    String?  // Responsable du service (Employee)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees  Employee[]
  teams      Team[]

  @@index([departmentId])
  @@index([code])
  @@index([isActive])
  @@map("services")
}

// Équipe de travail
model Team {
  id          String   @id @default(cuid())
  serviceId   String?  // Optionnel : une équipe peut être transversale
  code        String   @unique
  name        String
  description String?  @db.Text
  leaderId    String?  // Chef d'équipe (Employee)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service   Service?   @relation(fields: [serviceId], references: [id])
  employees Employee[]

  @@index([serviceId])
  @@index([code])
  @@index([isActive])
  @@map("teams")
}

// Poste / Fonction
model Position {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String   // Intitulé du poste
  description String?  @db.Text
  level       String?  // Niveau hiérarchique (Junior, Senior, Manager, etc.)
  category    String?  // Catégorie (Cadre, Agent de maîtrise, Employé, etc.)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@index([code])
  @@index([category])
  @@index([isActive])
  @@map("positions")
}